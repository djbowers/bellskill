# Local secrets for `supabase functions serve --env-file supabase/functions/.env`.
# Copy to `supabase/functions/.env` (gitignored) and fill in TEST-mode values.
# Deployed secrets are set separately via the Supabase Dashboard (Edge Functions -> Secrets).
#
# SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY are injected
# automatically by the local stack, so they don't need to go here.

STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PRICE_MONTHLY=price_1ThcqnCib7R9SbHP2cggT7O8
STRIPE_PRICE_YEARLY=price_1ThcrACib7R9SbHPaIUjx6lS
SITE_URL=http://localhost:5173

# stripe-webhook: local signing secret from `stripe listen --forward-to \
#   http://localhost:54321/functions/v1/stripe-webhook`
STRIPE_WEBHOOK_SECRET=whsec_xxx

# recommend-session (PROD-87): Anthropic API key for the workout recommender.
ANTHROPIC_API_KEY=sk-ant-xxx

# set-subscription (owner-only): comma-separated allowlist of emails permitted
# to flip subscription state. Optional — defaults to daniel_bowers@icloud.com.
# Set this as a deployed secret (Edge Functions -> Secrets) rather than relying
# on the hardcoded fallback.
OWNER_EMAILS=daniel_bowers@icloud.com
